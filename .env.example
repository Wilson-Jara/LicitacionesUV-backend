# Configuración pública de ejemplo; copiar como .env en esta raíz.
# No versionar el archivo .env real ni valores sensibles.
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Opcional para npm start: sin DATABASE_URL se usa el catálogo propio en memoria.
# Obligatoria para db:migrate, db:seed y db:setup.
# DATABASE_URL=postgresql://usuario:contrasena@localhost:5432/licitaciones_db

# Pruebas PostgreSQL: base desechable cuyo nombre termine en _test.
# Cada suite crea y elimina solo un esquema propio; no usa la base de desarrollo.
# DATABASE_URL_TEST=postgresql://usuario:contrasena@localhost:5432/licitaciones_test

# Inicio de sesión con Google (docs/api/auth-google.md). Sin GOOGLE_CLIENT_ID o
# JWT_SECRET, /api/auth/google y /api/auth/me responden 503 y el catálogo funciona igual.
# Client ID web de Google Cloud: audiencia esperada del ID token (no es secreto).
# GOOGLE_CLIENT_ID=000000000000-ejemplo.apps.googleusercontent.com
# Firma el token de sesión. Mínimo 32 caracteres aleatorios; nunca versionarlo. Generarlo con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# JWT_SECRET=reemplazar-por-un-secreto-aleatorio-de-al-menos-32-caracteres
# Duración de la sesión en horas (opcional, por defecto 8).
# AUTH_TOKEN_TTL_HORAS=8
