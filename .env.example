# Configuración pública de ejemplo; copiar como .env en esta raíz.
# No versionar el archivo .env real ni valores sensibles.
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Opcional para npm start: sin DATABASE_URL se usa el catálogo propio en memoria.
# Obligatoria para db:migrate, db:seed y db:setup.
# DATABASE_URL=postgresql://usuario:contrasena@localhost:5432/licitaciones_db

# Pruebas PostgreSQL: base desechable cuyo nombre termine en _test.
# Cada suite crea y elimina solo un esquema propio; no usa la base de desarrollo.
# DATABASE_URL_TEST=postgresql://usuario:contrasena@localhost:5432/licitaciones_test

# Reservada; autenticación todavía no implementada.
# JWT_SECRET=reemplazar-por-un-secreto-real
