# Configuración pública de ejemplo. Copiar como .env en la raíz del backend.
# No versionar el .env real ni secretos.
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Archivo SQLite. Las rutas relativas parten de la raíz del backend.
# Se crea la carpeta si falta. No requiere usuario ni contraseña.
DATABASE_PATH=./data/licitaciones.sqlite

# Reservada; autenticación todavía no implementada.
# JWT_SECRET=cambiar-por-un-secreto-real
